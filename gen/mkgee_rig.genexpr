Param gtr_gain(0.0, min=-24.0, max=24.0);
Param gtr_tone(6500.0, min=1500.0, max=20000.0);
Param drop_on(1.0, min=0.0, max=1.0);
Param drop_semi(-5.0, min=-24.0, max=12.0);
Param drop_mix(1.0, min=0.0, max=1.0);
Param drop_glide(30.0, min=1.0, max=2000.0);
Param drop_grain(55.0, min=15.0, max=100.0);
Param vibe_on(1.0, min=0.0, max=1.0);
Param vibe_mode(1.0, min=0.0, max=1.0);
Param vibe_rate(0.7, min=0.05, max=10.0);
Param vibe_depth(0.25, min=0.0, max=1.0);
Param vibe_tone(0.5, min=0.0, max=1.0);
Param eq_on(1.0, min=0.0, max=1.0);
Param eq_lofreq(200.0, min=40.0, max=800.0);
Param eq_logain(-2.0, min=-15.0, max=15.0);
Param eq_midfreq(1200.0, min=200.0, max=6000.0);
Param eq_midgain(2.0, min=-15.0, max=15.0);
Param eq_hifreq(6000.0, min=1500.0, max=16000.0);
Param eq_higain(-3.0, min=-15.0, max=15.0);
Param eq_lowcut(70.0, min=20.0, max=400.0);
Param eq_midq(0.8, min=0.2, max=6.0);
Param verb_on(1.0, min=0.0, max=1.0);
Param verb_pos(0.0, min=0.0, max=1.0);
Param verb_decay(1.2, min=0.1, max=8.0);
Param verb_size(0.4, min=0.0, max=1.0);
Param verb_tone(0.4, min=0.0, max=1.0);
Param verb_fuzz(0.35, min=0.0, max=1.0);
Param verb_mix(0.25, min=0.0, max=1.0);
Param echo_on(0.0, min=0.0, max=1.0);
Param echo_pos(1.0, min=0.0, max=1.0);
Param echo_time(380.0, min=20.0, max=2000.0);
Param echo_fb(0.3, min=0.0, max=1.05);
Param echo_tone(0.45, min=0.0, max=1.0);
Param echo_wob(0.2, min=0.0, max=1.0);
Param echo_pp(0.0, min=0.0, max=1.0);
Param echo_mix(0.2, min=0.0, max=1.0);
Param pre_on(1.0, min=0.0, max=1.0);
Param pre_trim(22.0, min=0.0, max=48.0);
Param pre_fader(6.0, min=-12.0, max=24.0);
Param pre_bass(-2.0, min=-12.0, max=12.0);
Param pre_treble(1.0, min=-12.0, max=12.0);
Param pre_mid(2.5, min=-6.0, max=9.0);
Param pre_level(0.0, min=-24.0, max=12.0);
Param tape_on(1.0, min=0.0, max=1.0);
Param tape_wow(0.3, min=0.0, max=1.0);
Param tape_flutter(0.25, min=0.0, max=1.0);
Param tape_sat(0.35, min=0.0, max=1.0);
Param tape_hiss(0.15, min=0.0, max=1.0);
Param tape_age(0.4, min=0.0, max=1.0);
Param tape_drop(0.05, min=0.0, max=1.0);
Param out_mix(1.0, min=0.0, max=1.0);
Param out_width(1.0, min=0.0, max=2.0);
Param out_gain(0.0, min=-24.0, max=12.0);

History h_gtr_gain(0.0);
History h_gtr_tone(6500.0);
History tn_s1(0.0);
History tn_s2(0.0);
History h_drop_on(1.0);
History h_drop_mix(1.0);
History h_drop_grain(55.0);
History h_dsemi(-5.0);
History dr_ph(0.0);
Delay dr_buf(24000);
History h_vibe_on(1.0);
History h_vibe_mode(1.0);
History h_vibe_rate(0.7);
History h_vibe_depth(0.25);
History h_vibe_tone(0.5);
History vb_ph(0.0);
Delay vb_buf(4096);
History vbf_s1(0.0);
History vbf_s2(0.0);
History h_eq_on(1.0);
History h_eq_lowcut(70.0);
History h_eq_lofreq(200.0);
History h_eq_logain(-2.0);
History h_eq_midfreq(1200.0);
History h_eq_midgain(2.0);
History h_eq_midq(0.8);
History h_eq_hifreq(6000.0);
History h_eq_higain(-3.0);
History eqhp_s1(0.0);
History eqhp_s2(0.0);
History eqlo_s1(0.0);
History eqlo_s2(0.0);
History eqmd_s1(0.0);
History eqmd_s2(0.0);
History eqhi_s1(0.0);
History eqhi_s2(0.0);
History h_verb_on(1.0);
History h_verb_pos(0.0);
History h_verb_decay(1.2);
History h_verb_size(0.4);
History h_verb_tone(0.4);
History h_verb_fuzz(0.35);
History h_verb_mix(0.25);
Delay rv_d0(20000);
History rv_lp0(0.0);
Delay rv_d1(20000);
History rv_lp1(0.0);
Delay rv_d2(20000);
History rv_lp2(0.0);
Delay rv_d3(20000);
History rv_lp3(0.0);
History rv_mph(0.0);
History h_echo_on(0.0);
History h_echo_pos(1.0);
History h_echo_time(380.0);
History h_echo_fb(0.3);
History h_echo_tone(0.45);
History h_echo_wob(0.2);
History h_echo_pp(0.0);
History h_echo_mix(0.2);
Delay ec_dL(200000);
Delay ec_dR(200000);
History ec_ph(0.0);
History ec_rn(0.0);
History h_pre_on(1.0);
History h_pre_trim(22.0);
History h_pre_fader(6.0);
History h_pre_bass(-2.0);
History h_pre_treble(1.0);
History h_pre_mid(2.5);
History h_pre_level(0.0);
History paLhpz_z(0.0);
History paLlp1_s1(0.0);
History paLlp1_s2(0.0);
History paLdc_z(0.0);
History paLbs_s1(0.0);
History paLbs_s2(0.0);
History paLmd_s1(0.0);
History paLmd_s2(0.0);
History paLtr_s1(0.0);
History paLtr_s2(0.0);
History paLlp2_s1(0.0);
History paLlp2_s2(0.0);
History paRhpz_z(0.0);
History paRlp1_s1(0.0);
History paRlp1_s2(0.0);
History paRdc_z(0.0);
History paRbs_s1(0.0);
History paRbs_s2(0.0);
History paRmd_s1(0.0);
History paRmd_s2(0.0);
History paRtr_s1(0.0);
History paRtr_s2(0.0);
History paRlp2_s1(0.0);
History paRlp2_s2(0.0);
History rvfz_s1(0.0);
History rvfz_s2(0.0);
Delay rv_ap0(3000);
Delay rv_ap1(3000);
Delay rv_ap2(3000);
Delay rv_ap3(3000);
History ecfL_s1(0.0);
History ecfL_s2(0.0);
History ecfR_s1(0.0);
History ecfR_s2(0.0);
History ecdcL_z(0.0);
History ecdcR_z(0.0);
History h_tape_on(1.0);
History h_tape_wow(0.3);
History h_tape_flutter(0.25);
History h_tape_sat(0.35);
History h_tape_hiss(0.15);
History h_tape_age(0.4);
History h_tape_drop(0.05);
History tp_w1(0.0);
History tp_w2(0.0);
History tp_f1(0.0);
History tp_rn(0.0);
History tp_env(0.0);
History tp_gz(1.0);
Delay tp_dL(4096);
History tpLbm_s1(0.0);
History tpLbm_s2(0.0);
History tpLlp_s1(0.0);
History tpLlp_s2(0.0);
History tpLnz_s1(0.0);
History tpLnz_s2(0.0);
Delay tp_dR(4096);
History tpRbm_s1(0.0);
History tpRbm_s2(0.0);
History tpRlp_s1(0.0);
History tpRlp_s2(0.0);
History tpRnz_s1(0.0);
History tpRnz_s2(0.0);
History h_out_mix(1.0);
History h_out_width(1.0);
History h_out_gain(0.0);

// ===== MKGEE RIG =====  generated by tools/dsp.py — edit there, not here
sr = samplerate;
k_fast = 1 - exp(-1 / (0.02 * sr));
k_on = 1 - exp(-1 / (0.012 * sr));
k_slow = 1 - exp(-1 / (0.25 * sr));
k_vslow = 1 - exp(-1 / (1.5 * sr));

// ---------------- GUITAR IN
s_gtr_gain = h_gtr_gain + (gtr_gain - h_gtr_gain) * k_fast;
h_gtr_gain = s_gtr_gain;
s_gtr_tone = h_gtr_tone + (gtr_tone - h_gtr_tone) * k_fast;
h_gtr_tone = s_gtr_tone;
x_in = (in1 + in2) * 0.5 * pow(10, s_gtr_gain / 20);
tn_g = tan(pi * clamp(s_gtr_tone, 10, sr * 0.45) / sr);
tn_k = 1 / (0.6);
tn_a1 = 1 / (1 + tn_g * (tn_g + tn_k));
tn_a2 = tn_g * tn_a1;
tn_a3 = tn_g * tn_a2;
tn_v3 = x_in - tn_s2;
tn_v1 = tn_a1 * tn_s1 + tn_a2 * tn_v3;
tn_v2 = tn_s2 + tn_a2 * tn_s1 + tn_a3 * tn_v3;
tn_n1 = 2 * tn_v1 - tn_s1;
tn_n2 = 2 * tn_v2 - tn_s2;
tn_s1 = tn_n1;
tn_s2 = tn_n2;
x = tn_v2;

// ---------------- DROP (dual-tap granular pitch shifter)
s_drop_on = h_drop_on + (drop_on - h_drop_on) * k_on;
h_drop_on = s_drop_on;
s_drop_mix = h_drop_mix + (drop_mix - h_drop_mix) * k_fast;
h_drop_mix = s_drop_mix;
s_drop_grain = h_drop_grain + (drop_grain - h_drop_grain) * k_slow;
h_drop_grain = s_drop_grain;
dr_kg = 1 - exp(-1 / (max(drop_glide, 1) * 0.001 * sr));
dr_semi = h_dsemi + (drop_semi - h_dsemi) * dr_kg;
h_dsemi = dr_semi;
dr_ratio = pow(2, dr_semi / 12);
dr_w = max(s_drop_grain * 0.001 * sr, 64);
dr_p = dr_ph + (1 - dr_ratio) / dr_w;
dr_p = dr_p - floor(dr_p);
dr_ph = dr_p;
dr_p2 = dr_p + 0.5;
dr_p2 = dr_p2 - floor(dr_p2);
dr_t1 = clamp(dr_p * dr_w + 1, 1, 23990);
dr_t2 = clamp(dr_p2 * dr_w + 1, 1, 23990);
dr_r1 = dr_buf.read(dr_t1);
dr_r2 = dr_buf.read(dr_t2);
dr_w1 = sin(pi * dr_p);
dr_w2 = sin(pi * dr_p2);
dr_wet = dr_r1 * dr_w1 * dr_w1 + dr_r2 * dr_w2 * dr_w2;
dr_buf.write(x);
dr_out = x * (1 - s_drop_mix) + dr_wet * s_drop_mix;
x = x + (dr_out - x) * s_drop_on;

// ---------------- CE-2W (BBD chorus / vibrato)
s_vibe_on = h_vibe_on + (vibe_on - h_vibe_on) * k_on;
h_vibe_on = s_vibe_on;
s_vibe_mode = h_vibe_mode + (vibe_mode - h_vibe_mode) * k_on;
h_vibe_mode = s_vibe_mode;
s_vibe_rate = h_vibe_rate + (vibe_rate - h_vibe_rate) * k_fast;
h_vibe_rate = s_vibe_rate;
s_vibe_depth = h_vibe_depth + (vibe_depth - h_vibe_depth) * k_fast;
h_vibe_depth = s_vibe_depth;
s_vibe_tone = h_vibe_tone + (vibe_tone - h_vibe_tone) * k_fast;
h_vibe_tone = s_vibe_tone;
vb_p = vb_ph + s_vibe_rate / sr;
vb_p = vb_p - floor(vb_p);
vb_ph = vb_p;
vb_tri = 1 - 4 * abs(vb_p - 0.5);
vb_lfo = vb_tri * (1 - 0.35 * vb_tri * vb_tri) / 0.65;
vb_center = (6.5 - 2.5 * s_vibe_mode) * 0.001 * sr;
vb_swing = (1.6 + 1.8 * s_vibe_mode) * s_vibe_depth * 0.001 * sr;
vb_t = clamp(vb_center + vb_lfo * vb_swing, 2, 4090);
vb_pre = tanh(x * 1.6) / 1.6;
vb_buf.write(vb_pre);
vb_r = vb_buf.read(vb_t);
vbf_g = tan(pi * clamp(3000 + s_vibe_tone * s_vibe_tone * 9000, 10, sr * 0.45) / sr);
vbf_k = 1 / (0.6);
vbf_a1 = 1 / (1 + vbf_g * (vbf_g + vbf_k));
vbf_a2 = vbf_g * vbf_a1;
vbf_a3 = vbf_g * vbf_a2;
vbf_v3 = vb_r - vbf_s2;
vbf_v1 = vbf_a1 * vbf_s1 + vbf_a2 * vbf_v3;
vbf_v2 = vbf_s2 + vbf_a2 * vbf_s1 + vbf_a3 * vbf_v3;
vbf_n1 = 2 * vbf_v1 - vbf_s1;
vbf_n2 = 2 * vbf_v2 - vbf_s2;
vbf_s1 = vbf_n1;
vbf_s2 = vbf_n2;
vb_wet = vbf_v2 + (noise() * 0.0004) * s_vibe_depth;
vb_out = x * (1 - s_vibe_mode) * 0.75 + vb_wet * (0.75 + 0.25 * s_vibe_mode);
x = x + (vb_out - x) * s_vibe_on;

// ---------------- PARA EQ
s_eq_on = h_eq_on + (eq_on - h_eq_on) * k_on;
h_eq_on = s_eq_on;
s_eq_lowcut = h_eq_lowcut + (eq_lowcut - h_eq_lowcut) * k_fast;
h_eq_lowcut = s_eq_lowcut;
s_eq_lofreq = h_eq_lofreq + (eq_lofreq - h_eq_lofreq) * k_fast;
h_eq_lofreq = s_eq_lofreq;
s_eq_logain = h_eq_logain + (eq_logain - h_eq_logain) * k_fast;
h_eq_logain = s_eq_logain;
s_eq_midfreq = h_eq_midfreq + (eq_midfreq - h_eq_midfreq) * k_fast;
h_eq_midfreq = s_eq_midfreq;
s_eq_midgain = h_eq_midgain + (eq_midgain - h_eq_midgain) * k_fast;
h_eq_midgain = s_eq_midgain;
s_eq_midq = h_eq_midq + (eq_midq - h_eq_midq) * k_fast;
h_eq_midq = s_eq_midq;
s_eq_hifreq = h_eq_hifreq + (eq_hifreq - h_eq_hifreq) * k_fast;
h_eq_hifreq = s_eq_hifreq;
s_eq_higain = h_eq_higain + (eq_higain - h_eq_higain) * k_fast;
h_eq_higain = s_eq_higain;
eqhp_g = tan(pi * clamp(s_eq_lowcut, 10, sr * 0.45) / sr);
eqhp_k = 1 / (0.7071);
eqhp_a1 = 1 / (1 + eqhp_g * (eqhp_g + eqhp_k));
eqhp_a2 = eqhp_g * eqhp_a1;
eqhp_a3 = eqhp_g * eqhp_a2;
eqhp_v3 = x - eqhp_s2;
eqhp_v1 = eqhp_a1 * eqhp_s1 + eqhp_a2 * eqhp_v3;
eqhp_v2 = eqhp_s2 + eqhp_a2 * eqhp_s1 + eqhp_a3 * eqhp_v3;
eqhp_n1 = 2 * eqhp_v1 - eqhp_s1;
eqhp_n2 = 2 * eqhp_v2 - eqhp_s2;
eqhp_s1 = eqhp_n1;
eqhp_s2 = eqhp_n2;
eqhp_o = x - eqhp_k * eqhp_v1 - eqhp_v2;
eqlo_A = pow(10, (s_eq_logain) / 40);
eqlo_g = tan(pi * clamp(s_eq_lofreq, 10, sr * 0.45) / sr) / sqrt(eqlo_A);
eqlo_k = 1 / (0.7071);
eqlo_a1 = 1 / (1 + eqlo_g * (eqlo_g + eqlo_k));
eqlo_a2 = eqlo_g * eqlo_a1;
eqlo_a3 = eqlo_g * eqlo_a2;
eqlo_v3 = eqhp_o - eqlo_s2;
eqlo_v1 = eqlo_a1 * eqlo_s1 + eqlo_a2 * eqlo_v3;
eqlo_v2 = eqlo_s2 + eqlo_a2 * eqlo_s1 + eqlo_a3 * eqlo_v3;
eqlo_n1 = 2 * eqlo_v1 - eqlo_s1;
eqlo_n2 = 2 * eqlo_v2 - eqlo_s2;
eqlo_s1 = eqlo_n1;
eqlo_s2 = eqlo_n2;
eqlo_o = eqhp_o + eqlo_k * (eqlo_A - 1) * eqlo_v1 + (eqlo_A * eqlo_A - 1) * eqlo_v2;
eqmd_A = pow(10, (s_eq_midgain) / 40);
eqmd_g = tan(pi * clamp(s_eq_midfreq, 10, sr * 0.45) / sr);
eqmd_k = 1 / ((s_eq_midq) * eqmd_A);
eqmd_a1 = 1 / (1 + eqmd_g * (eqmd_g + eqmd_k));
eqmd_a2 = eqmd_g * eqmd_a1;
eqmd_a3 = eqmd_g * eqmd_a2;
eqmd_v3 = eqlo_o - eqmd_s2;
eqmd_v1 = eqmd_a1 * eqmd_s1 + eqmd_a2 * eqmd_v3;
eqmd_v2 = eqmd_s2 + eqmd_a2 * eqmd_s1 + eqmd_a3 * eqmd_v3;
eqmd_n1 = 2 * eqmd_v1 - eqmd_s1;
eqmd_n2 = 2 * eqmd_v2 - eqmd_s2;
eqmd_s1 = eqmd_n1;
eqmd_s2 = eqmd_n2;
eqmd_o = eqlo_o + eqmd_k * (eqmd_A * eqmd_A - 1) * eqmd_v1;
eqhi_A = pow(10, (s_eq_higain) / 40);
eqhi_g = tan(pi * clamp(s_eq_hifreq, 10, sr * 0.45) / sr) * sqrt(eqhi_A);
eqhi_k = 1 / (0.7071);
eqhi_a1 = 1 / (1 + eqhi_g * (eqhi_g + eqhi_k));
eqhi_a2 = eqhi_g * eqhi_a1;
eqhi_a3 = eqhi_g * eqhi_a2;
eqhi_v3 = eqmd_o - eqhi_s2;
eqhi_v1 = eqhi_a1 * eqhi_s1 + eqhi_a2 * eqhi_v3;
eqhi_v2 = eqhi_s2 + eqhi_a2 * eqhi_s1 + eqhi_a3 * eqhi_v3;
eqhi_n1 = 2 * eqhi_v1 - eqhi_s1;
eqhi_n2 = 2 * eqhi_v2 - eqhi_s2;
eqhi_s1 = eqhi_n1;
eqhi_s2 = eqhi_n2;
eqhi_o = eqhi_A * eqhi_A * eqmd_o + eqhi_k * (1 - eqhi_A) * eqhi_A * eqhi_v1 + (1 - eqhi_A * eqhi_A) * eqhi_v2;
x = x + (eqhi_o - x) * s_eq_on;
sL = x;
sR = x;

// ---------------- REVERB-X  (4-line FDN, wet taps read first)
s_verb_on = h_verb_on + (verb_on - h_verb_on) * k_on;
h_verb_on = s_verb_on;
s_verb_pos = h_verb_pos + (verb_pos - h_verb_pos) * k_on;
h_verb_pos = s_verb_pos;
s_verb_decay = h_verb_decay + (verb_decay - h_verb_decay) * k_fast;
h_verb_decay = s_verb_decay;
s_verb_size = h_verb_size + (verb_size - h_verb_size) * k_vslow;
h_verb_size = s_verb_size;
s_verb_tone = h_verb_tone + (verb_tone - h_verb_tone) * k_fast;
h_verb_tone = s_verb_tone;
s_verb_fuzz = h_verb_fuzz + (verb_fuzz - h_verb_fuzz) * k_fast;
h_verb_fuzz = s_verb_fuzz;
s_verb_mix = h_verb_mix + (verb_mix - h_verb_mix) * k_fast;
h_verb_mix = s_verb_mix;
rv_sz = 0.35 + s_verb_size * 1.25;
rv_len0 = 31.7 * rv_sz * 0.001 * sr;
rv_len1 = 37.3 * rv_sz * 0.001 * sr;
rv_len2 = 41.9 * rv_sz * 0.001 * sr;
rv_len3 = 47.3 * rv_sz * 0.001 * sr;
rv_m = rv_mph + 0.73 / sr;
rv_m = rv_m - floor(rv_m);
rv_mph = rv_m;
rv_mod = sin(twopi * rv_m) * 0.0009 * sr;
rv_r0 = rv_d0.read(clamp(rv_len0 + rv_mod, 2, 19990));
rv_r1 = rv_d1.read(clamp(rv_len1, 2, 19990));
rv_r2 = rv_d2.read(clamp(rv_len2 - rv_mod, 2, 19990));
rv_r3 = rv_d3.read(clamp(rv_len3, 2, 19990));
rv_wL = (rv_r0 + rv_r2) * 0.5;
rv_wR = (rv_r1 + rv_r3) * 0.5;

// ---------------- DD-20 echo (wet taps read first)
s_echo_on = h_echo_on + (echo_on - h_echo_on) * k_on;
h_echo_on = s_echo_on;
s_echo_pos = h_echo_pos + (echo_pos - h_echo_pos) * k_on;
h_echo_pos = s_echo_pos;
s_echo_time = h_echo_time + (echo_time - h_echo_time) * k_slow;
h_echo_time = s_echo_time;
s_echo_fb = h_echo_fb + (echo_fb - h_echo_fb) * k_fast;
h_echo_fb = s_echo_fb;
s_echo_tone = h_echo_tone + (echo_tone - h_echo_tone) * k_fast;
h_echo_tone = s_echo_tone;
s_echo_wob = h_echo_wob + (echo_wob - h_echo_wob) * k_fast;
h_echo_wob = s_echo_wob;
s_echo_pp = h_echo_pp + (echo_pp - h_echo_pp) * k_fast;
h_echo_pp = s_echo_pp;
s_echo_mix = h_echo_mix + (echo_mix - h_echo_mix) * k_fast;
h_echo_mix = s_echo_mix;
ec_p = ec_ph + 0.9 / sr;
ec_p = ec_p - floor(ec_p);
ec_ph = ec_p;
ec_rnd = ec_rn + (noise() - ec_rn) * (twopi * 3 / sr);
ec_rn = ec_rnd;
ec_wob = (sin(twopi * ec_p) * 0.7 + ec_rnd * 6) * s_echo_wob * 0.0025 * sr;
ec_t = clamp(s_echo_time * 0.001 * sr + ec_wob, 4, 199000);
ec_rL = ec_dL.read(ec_t);
ec_rR = ec_dR.read(ec_t);

// ---------------- routing: [verb pre] [echo pre] 424 [verb post] [echo post]
rv_dry = 1 - 0.45 * s_verb_mix;
rv_on = s_verb_on;
rv_pre = rv_on * (1 - s_verb_pos);
rv_post = rv_on * s_verb_pos;
ec_pre = s_echo_on * (1 - s_echo_pos);
ec_post = s_echo_on * s_echo_pos;
rv_inL_a = sL;
rv_inR_a = sR;
sL = sL + ((sL * rv_dry + rv_wL * s_verb_mix) - sL) * rv_pre;
sR = sR + ((sR * rv_dry + rv_wR * s_verb_mix) - sR) * rv_pre;
ec_inL_a = sL;
ec_inR_a = sR;
sL = sL + ec_rL * s_echo_mix * ec_pre;
sR = sR + ec_rR * s_echo_mix * ec_pre;

// ---------------- TASCAM 424 MkI channel: Trim > op-amp > EQ > Fader > op-amp
s_pre_on = h_pre_on + (pre_on - h_pre_on) * k_on;
h_pre_on = s_pre_on;
s_pre_trim = h_pre_trim + (pre_trim - h_pre_trim) * k_fast;
h_pre_trim = s_pre_trim;
s_pre_fader = h_pre_fader + (pre_fader - h_pre_fader) * k_fast;
h_pre_fader = s_pre_fader;
s_pre_bass = h_pre_bass + (pre_bass - h_pre_bass) * k_fast;
h_pre_bass = s_pre_bass;
s_pre_treble = h_pre_treble + (pre_treble - h_pre_treble) * k_fast;
h_pre_treble = s_pre_treble;
s_pre_mid = h_pre_mid + (pre_mid - h_pre_mid) * k_fast;
h_pre_mid = s_pre_mid;
s_pre_level = h_pre_level + (pre_level - h_pre_level) * k_fast;
h_pre_level = s_pre_level;
pa_g1 = pow(10, s_pre_trim / 20);
pa_g2 = pow(10, s_pre_fader / 20);
pa_bw = clamp(17000 - s_pre_trim * 230, 5500, 17000);
pa_lev = pow(10, s_pre_level / 20);
paLhpz_c = 1 - exp(-twopi * clamp(55, 5, sr * 0.45) / sr);
paLhpz_y = paLhpz_z + (sL - paLhpz_z) * paLhpz_c;
paLhpz_z = paLhpz_y;
paL_x = (sL - paLhpz_y) * pa_g1;
paL_u = paL_x + 0.18;
paL_c1 = paL_u / pow(1 + pow(abs(paL_u), 2.5), 0.4) - 0.18 / pow(1 + pow(0.18, 2.5), 0.4);
paLlp1_g = tan(pi * clamp(pa_bw, 10, sr * 0.45) / sr);
paLlp1_k = 1 / (0.6);
paLlp1_a1 = 1 / (1 + paLlp1_g * (paLlp1_g + paLlp1_k));
paLlp1_a2 = paLlp1_g * paLlp1_a1;
paLlp1_a3 = paLlp1_g * paLlp1_a2;
paLlp1_v3 = paL_c1 - paLlp1_s2;
paLlp1_v1 = paLlp1_a1 * paLlp1_s1 + paLlp1_a2 * paLlp1_v3;
paLlp1_v2 = paLlp1_s2 + paLlp1_a2 * paLlp1_s1 + paLlp1_a3 * paLlp1_v3;
paLlp1_n1 = 2 * paLlp1_v1 - paLlp1_s1;
paLlp1_n2 = 2 * paLlp1_v2 - paLlp1_s2;
paLlp1_s1 = paLlp1_n1;
paLlp1_s2 = paLlp1_n2;
paLdc_c = 1 - exp(-twopi * clamp(12, 5, sr * 0.45) / sr);
paLdc_y = paLdc_z + (paLlp1_v2 - paLdc_z) * paLdc_c;
paLdc_z = paLdc_y;
paL_y = paLlp1_v2 - paLdc_y;
paLbs_A = pow(10, (s_pre_bass) / 40);
paLbs_g = tan(pi * clamp(100, 10, sr * 0.45) / sr) / sqrt(paLbs_A);
paLbs_k = 1 / (0.7071);
paLbs_a1 = 1 / (1 + paLbs_g * (paLbs_g + paLbs_k));
paLbs_a2 = paLbs_g * paLbs_a1;
paLbs_a3 = paLbs_g * paLbs_a2;
paLbs_v3 = paL_y - paLbs_s2;
paLbs_v1 = paLbs_a1 * paLbs_s1 + paLbs_a2 * paLbs_v3;
paLbs_v2 = paLbs_s2 + paLbs_a2 * paLbs_s1 + paLbs_a3 * paLbs_v3;
paLbs_n1 = 2 * paLbs_v1 - paLbs_s1;
paLbs_n2 = 2 * paLbs_v2 - paLbs_s2;
paLbs_s1 = paLbs_n1;
paLbs_s2 = paLbs_n2;
paLbs_o = paL_y + paLbs_k * (paLbs_A - 1) * paLbs_v1 + (paLbs_A * paLbs_A - 1) * paLbs_v2;
paLmd_A = pow(10, (s_pre_mid) / 40);
paLmd_g = tan(pi * clamp(900, 10, sr * 0.45) / sr);
paLmd_k = 1 / ((0.6) * paLmd_A);
paLmd_a1 = 1 / (1 + paLmd_g * (paLmd_g + paLmd_k));
paLmd_a2 = paLmd_g * paLmd_a1;
paLmd_a3 = paLmd_g * paLmd_a2;
paLmd_v3 = paLbs_o - paLmd_s2;
paLmd_v1 = paLmd_a1 * paLmd_s1 + paLmd_a2 * paLmd_v3;
paLmd_v2 = paLmd_s2 + paLmd_a2 * paLmd_s1 + paLmd_a3 * paLmd_v3;
paLmd_n1 = 2 * paLmd_v1 - paLmd_s1;
paLmd_n2 = 2 * paLmd_v2 - paLmd_s2;
paLmd_s1 = paLmd_n1;
paLmd_s2 = paLmd_n2;
paLmd_o = paLbs_o + paLmd_k * (paLmd_A * paLmd_A - 1) * paLmd_v1;
paLtr_A = pow(10, (s_pre_treble) / 40);
paLtr_g = tan(pi * clamp(10000, 10, sr * 0.45) / sr) * sqrt(paLtr_A);
paLtr_k = 1 / (0.7071);
paLtr_a1 = 1 / (1 + paLtr_g * (paLtr_g + paLtr_k));
paLtr_a2 = paLtr_g * paLtr_a1;
paLtr_a3 = paLtr_g * paLtr_a2;
paLtr_v3 = paLmd_o - paLtr_s2;
paLtr_v1 = paLtr_a1 * paLtr_s1 + paLtr_a2 * paLtr_v3;
paLtr_v2 = paLtr_s2 + paLtr_a2 * paLtr_s1 + paLtr_a3 * paLtr_v3;
paLtr_n1 = 2 * paLtr_v1 - paLtr_s1;
paLtr_n2 = 2 * paLtr_v2 - paLtr_s2;
paLtr_s1 = paLtr_n1;
paLtr_s2 = paLtr_n2;
paLtr_o = paLtr_A * paLtr_A * paLmd_o + paLtr_k * (1 - paLtr_A) * paLtr_A * paLtr_v1 + (1 - paLtr_A * paLtr_A) * paLtr_v2;
paL_v = paLtr_o * pa_g2 + 0.06;
paL_c2 = paL_v / pow(1 + pow(abs(paL_v), 4), 0.25) - 0.06 / pow(1 + pow(0.06, 4), 0.25);
paLlp2_g = tan(pi * clamp(15000, 10, sr * 0.45) / sr);
paLlp2_k = 1 / (0.7071);
paLlp2_a1 = 1 / (1 + paLlp2_g * (paLlp2_g + paLlp2_k));
paLlp2_a2 = paLlp2_g * paLlp2_a1;
paLlp2_a3 = paLlp2_g * paLlp2_a2;
paLlp2_v3 = paL_c2 - paLlp2_s2;
paLlp2_v1 = paLlp2_a1 * paLlp2_s1 + paLlp2_a2 * paLlp2_v3;
paLlp2_v2 = paLlp2_s2 + paLlp2_a2 * paLlp2_s1 + paLlp2_a3 * paLlp2_v3;
paLlp2_n1 = 2 * paLlp2_v1 - paLlp2_s1;
paLlp2_n2 = 2 * paLlp2_v2 - paLlp2_s2;
paLlp2_s1 = paLlp2_n1;
paLlp2_s2 = paLlp2_n2;
paL_o = paLlp2_v2 * pa_lev * 0.15;
sL = sL + (paL_o - sL) * s_pre_on;
paRhpz_c = 1 - exp(-twopi * clamp(55, 5, sr * 0.45) / sr);
paRhpz_y = paRhpz_z + (sR - paRhpz_z) * paRhpz_c;
paRhpz_z = paRhpz_y;
paR_x = (sR - paRhpz_y) * pa_g1;
paR_u = paR_x + 0.18;
paR_c1 = paR_u / pow(1 + pow(abs(paR_u), 2.5), 0.4) - 0.18 / pow(1 + pow(0.18, 2.5), 0.4);
paRlp1_g = tan(pi * clamp(pa_bw, 10, sr * 0.45) / sr);
paRlp1_k = 1 / (0.6);
paRlp1_a1 = 1 / (1 + paRlp1_g * (paRlp1_g + paRlp1_k));
paRlp1_a2 = paRlp1_g * paRlp1_a1;
paRlp1_a3 = paRlp1_g * paRlp1_a2;
paRlp1_v3 = paR_c1 - paRlp1_s2;
paRlp1_v1 = paRlp1_a1 * paRlp1_s1 + paRlp1_a2 * paRlp1_v3;
paRlp1_v2 = paRlp1_s2 + paRlp1_a2 * paRlp1_s1 + paRlp1_a3 * paRlp1_v3;
paRlp1_n1 = 2 * paRlp1_v1 - paRlp1_s1;
paRlp1_n2 = 2 * paRlp1_v2 - paRlp1_s2;
paRlp1_s1 = paRlp1_n1;
paRlp1_s2 = paRlp1_n2;
paRdc_c = 1 - exp(-twopi * clamp(12, 5, sr * 0.45) / sr);
paRdc_y = paRdc_z + (paRlp1_v2 - paRdc_z) * paRdc_c;
paRdc_z = paRdc_y;
paR_y = paRlp1_v2 - paRdc_y;
paRbs_A = pow(10, (s_pre_bass) / 40);
paRbs_g = tan(pi * clamp(100, 10, sr * 0.45) / sr) / sqrt(paRbs_A);
paRbs_k = 1 / (0.7071);
paRbs_a1 = 1 / (1 + paRbs_g * (paRbs_g + paRbs_k));
paRbs_a2 = paRbs_g * paRbs_a1;
paRbs_a3 = paRbs_g * paRbs_a2;
paRbs_v3 = paR_y - paRbs_s2;
paRbs_v1 = paRbs_a1 * paRbs_s1 + paRbs_a2 * paRbs_v3;
paRbs_v2 = paRbs_s2 + paRbs_a2 * paRbs_s1 + paRbs_a3 * paRbs_v3;
paRbs_n1 = 2 * paRbs_v1 - paRbs_s1;
paRbs_n2 = 2 * paRbs_v2 - paRbs_s2;
paRbs_s1 = paRbs_n1;
paRbs_s2 = paRbs_n2;
paRbs_o = paR_y + paRbs_k * (paRbs_A - 1) * paRbs_v1 + (paRbs_A * paRbs_A - 1) * paRbs_v2;
paRmd_A = pow(10, (s_pre_mid) / 40);
paRmd_g = tan(pi * clamp(900, 10, sr * 0.45) / sr);
paRmd_k = 1 / ((0.6) * paRmd_A);
paRmd_a1 = 1 / (1 + paRmd_g * (paRmd_g + paRmd_k));
paRmd_a2 = paRmd_g * paRmd_a1;
paRmd_a3 = paRmd_g * paRmd_a2;
paRmd_v3 = paRbs_o - paRmd_s2;
paRmd_v1 = paRmd_a1 * paRmd_s1 + paRmd_a2 * paRmd_v3;
paRmd_v2 = paRmd_s2 + paRmd_a2 * paRmd_s1 + paRmd_a3 * paRmd_v3;
paRmd_n1 = 2 * paRmd_v1 - paRmd_s1;
paRmd_n2 = 2 * paRmd_v2 - paRmd_s2;
paRmd_s1 = paRmd_n1;
paRmd_s2 = paRmd_n2;
paRmd_o = paRbs_o + paRmd_k * (paRmd_A * paRmd_A - 1) * paRmd_v1;
paRtr_A = pow(10, (s_pre_treble) / 40);
paRtr_g = tan(pi * clamp(10000, 10, sr * 0.45) / sr) * sqrt(paRtr_A);
paRtr_k = 1 / (0.7071);
paRtr_a1 = 1 / (1 + paRtr_g * (paRtr_g + paRtr_k));
paRtr_a2 = paRtr_g * paRtr_a1;
paRtr_a3 = paRtr_g * paRtr_a2;
paRtr_v3 = paRmd_o - paRtr_s2;
paRtr_v1 = paRtr_a1 * paRtr_s1 + paRtr_a2 * paRtr_v3;
paRtr_v2 = paRtr_s2 + paRtr_a2 * paRtr_s1 + paRtr_a3 * paRtr_v3;
paRtr_n1 = 2 * paRtr_v1 - paRtr_s1;
paRtr_n2 = 2 * paRtr_v2 - paRtr_s2;
paRtr_s1 = paRtr_n1;
paRtr_s2 = paRtr_n2;
paRtr_o = paRtr_A * paRtr_A * paRmd_o + paRtr_k * (1 - paRtr_A) * paRtr_A * paRtr_v1 + (1 - paRtr_A * paRtr_A) * paRtr_v2;
paR_v = paRtr_o * pa_g2 + 0.06;
paR_c2 = paR_v / pow(1 + pow(abs(paR_v), 4), 0.25) - 0.06 / pow(1 + pow(0.06, 4), 0.25);
paRlp2_g = tan(pi * clamp(15000, 10, sr * 0.45) / sr);
paRlp2_k = 1 / (0.7071);
paRlp2_a1 = 1 / (1 + paRlp2_g * (paRlp2_g + paRlp2_k));
paRlp2_a2 = paRlp2_g * paRlp2_a1;
paRlp2_a3 = paRlp2_g * paRlp2_a2;
paRlp2_v3 = paR_c2 - paRlp2_s2;
paRlp2_v1 = paRlp2_a1 * paRlp2_s1 + paRlp2_a2 * paRlp2_v3;
paRlp2_v2 = paRlp2_s2 + paRlp2_a2 * paRlp2_s1 + paRlp2_a3 * paRlp2_v3;
paRlp2_n1 = 2 * paRlp2_v1 - paRlp2_s1;
paRlp2_n2 = 2 * paRlp2_v2 - paRlp2_s2;
paRlp2_s1 = paRlp2_n1;
paRlp2_s2 = paRlp2_n2;
paR_o = paRlp2_v2 * pa_lev * 0.15;
sR = sR + (paR_o - sR) * s_pre_on;

// ---------------- post-424 verb / echo
rv_inL_b = sL;
rv_inR_b = sR;
sL = sL + ((sL * rv_dry + rv_wL * s_verb_mix) - sL) * rv_post;
sR = sR + ((sR * rv_dry + rv_wR * s_verb_mix) - sR) * rv_post;
ec_inL_b = sL;
ec_inR_b = sR;
sL = sL + ec_rL * s_echo_mix * ec_post;
sR = sR + ec_rR * s_echo_mix * ec_post;

// ---------------- REVERB-X write: fuzz > diffusers > FDN
rv_in = ((rv_inL_a + rv_inR_a) * (1 - s_verb_pos) + (rv_inL_b + rv_inR_b) * s_verb_pos) * 0.5 * rv_on;
rv_drv = 1 + s_verb_fuzz * s_verb_fuzz * 80;
rv_fz = rv_in + (tanh(rv_in * rv_drv) * 0.3 - rv_in) * s_verb_fuzz;
rvfz_g = tan(pi * clamp(9000 - s_verb_fuzz * 5500, 10, sr * 0.45) / sr);
rvfz_k = 1 / (0.7071);
rvfz_a1 = 1 / (1 + rvfz_g * (rvfz_g + rvfz_k));
rvfz_a2 = rvfz_g * rvfz_a1;
rvfz_a3 = rvfz_g * rvfz_a2;
rvfz_v3 = rv_fz - rvfz_s2;
rvfz_v1 = rvfz_a1 * rvfz_s1 + rvfz_a2 * rvfz_v3;
rvfz_v2 = rvfz_s2 + rvfz_a2 * rvfz_s1 + rvfz_a3 * rvfz_v3;
rvfz_n1 = 2 * rvfz_v1 - rvfz_s1;
rvfz_n2 = 2 * rvfz_v2 - rvfz_s2;
rvfz_s1 = rvfz_n1;
rvfz_s2 = rvfz_n2;
rv_a = rvfz_v2;
rv_apr0 = rv_ap0.read(clamp(4.77 * 0.001 * sr * (0.6 + rv_sz * 0.4), 1, 2990));
rv_apw0 = rv_a + 0.62 * rv_apr0;
rv_a = rv_apr0 - 0.62 * rv_apw0;
rv_ap0.write(rv_apw0);
rv_apr1 = rv_ap1.read(clamp(3.59 * 0.001 * sr * (0.6 + rv_sz * 0.4), 1, 2990));
rv_apw1 = rv_a + 0.62 * rv_apr1;
rv_a = rv_apr1 - 0.62 * rv_apw1;
rv_ap1.write(rv_apw1);
rv_apr2 = rv_ap2.read(clamp(2.73 * 0.001 * sr * (0.6 + rv_sz * 0.4), 1, 2990));
rv_apw2 = rv_a + 0.62 * rv_apr2;
rv_a = rv_apr2 - 0.62 * rv_apw2;
rv_ap2.write(rv_apw2);
rv_apr3 = rv_ap3.read(clamp(1.91 * 0.001 * sr * (0.6 + rv_sz * 0.4), 1, 2990));
rv_apw3 = rv_a + 0.62 * rv_apr3;
rv_a = rv_apr3 - 0.62 * rv_apw3;
rv_ap3.write(rv_apw3);
rv_damp = 1500 + s_verb_tone * s_verb_tone * 14000;
rv_dc = 1 - exp(-twopi * clamp(rv_damp, 100, sr * 0.45) / sr);
rv_T = max(s_verb_decay, 0.05) * sr;
rv_g0 = pow(0.001, rv_len0 / rv_T);
rv_f0 = rv_lp0 + (rv_r0 * rv_g0 - rv_lp0) * rv_dc;
rv_lp0 = rv_f0;
rv_g1 = pow(0.001, rv_len1 / rv_T);
rv_f1 = rv_lp1 + (rv_r1 * rv_g1 - rv_lp1) * rv_dc;
rv_lp1 = rv_f1;
rv_g2 = pow(0.001, rv_len2 / rv_T);
rv_f2 = rv_lp2 + (rv_r2 * rv_g2 - rv_lp2) * rv_dc;
rv_lp2 = rv_f2;
rv_g3 = pow(0.001, rv_len3 / rv_T);
rv_f3 = rv_lp3 + (rv_r3 * rv_g3 - rv_lp3) * rv_dc;
rv_lp3 = rv_f3;
rv_h0 = (rv_f0 + rv_f1 + rv_f2 + rv_f3) * 0.5;
rv_h1 = (rv_f0 - rv_f1 + rv_f2 - rv_f3) * 0.5;
rv_h2 = (rv_f0 + rv_f1 - rv_f2 - rv_f3) * 0.5;
rv_h3 = (rv_f0 - rv_f1 - rv_f2 + rv_f3) * 0.5;
rv_d0.write(rv_a * 0.5 + rv_h0);
rv_d1.write(-rv_a * 0.5 + rv_h1);
rv_d2.write(rv_a * 0.5 + rv_h2);
rv_d3.write(-rv_a * 0.5 + rv_h3);

// ---------------- DD-20 write: tone + soft clip in the loop, ping-pong
ec_inL = (ec_inL_a * (1 - s_echo_pos) + ec_inL_b * s_echo_pos) * s_echo_on;
ec_inR = (ec_inR_a * (1 - s_echo_pos) + ec_inR_b * s_echo_pos) * s_echo_on;
ec_tf = 900 + s_echo_tone * s_echo_tone * 11000;
ecfL_g = tan(pi * clamp(ec_tf, 10, sr * 0.45) / sr);
ecfL_k = 1 / (0.6);
ecfL_a1 = 1 / (1 + ecfL_g * (ecfL_g + ecfL_k));
ecfL_a2 = ecfL_g * ecfL_a1;
ecfL_a3 = ecfL_g * ecfL_a2;
ecfL_v3 = ec_rL - ecfL_s2;
ecfL_v1 = ecfL_a1 * ecfL_s1 + ecfL_a2 * ecfL_v3;
ecfL_v2 = ecfL_s2 + ecfL_a2 * ecfL_s1 + ecfL_a3 * ecfL_v3;
ecfL_n1 = 2 * ecfL_v1 - ecfL_s1;
ecfL_n2 = 2 * ecfL_v2 - ecfL_s2;
ecfL_s1 = ecfL_n1;
ecfL_s2 = ecfL_n2;
ecfR_g = tan(pi * clamp(ec_tf, 10, sr * 0.45) / sr);
ecfR_k = 1 / (0.6);
ecfR_a1 = 1 / (1 + ecfR_g * (ecfR_g + ecfR_k));
ecfR_a2 = ecfR_g * ecfR_a1;
ecfR_a3 = ecfR_g * ecfR_a2;
ecfR_v3 = ec_rR - ecfR_s2;
ecfR_v1 = ecfR_a1 * ecfR_s1 + ecfR_a2 * ecfR_v3;
ecfR_v2 = ecfR_s2 + ecfR_a2 * ecfR_s1 + ecfR_a3 * ecfR_v3;
ecfR_n1 = 2 * ecfR_v1 - ecfR_s1;
ecfR_n2 = 2 * ecfR_v2 - ecfR_s2;
ecfR_s1 = ecfR_n1;
ecfR_s2 = ecfR_n2;
ecdcL_c = 1 - exp(-twopi * clamp(60, 5, sr * 0.45) / sr);
ecdcL_y = ecdcL_z + (ecfL_v2 - ecdcL_z) * ecdcL_c;
ecdcL_z = ecdcL_y;
ecdcR_c = 1 - exp(-twopi * clamp(60, 5, sr * 0.45) / sr);
ecdcR_y = ecdcR_z + (ecfR_v2 - ecdcR_z) * ecdcR_c;
ecdcR_z = ecdcR_y;
ec_fbL = tanh((ecfL_v2 - ecdcL_y) * 1.3) / 1.3;
ec_fbR = tanh((ecfR_v2 - ecdcR_y) * 1.3) / 1.3;
ec_mono = (ec_inL + ec_inR) * 0.5;
ec_dL.write(ec_inL + (ec_mono - ec_inL) * s_echo_pp + s_echo_fb * (ec_fbL * (1 - s_echo_pp) + ec_fbR * s_echo_pp));
ec_dR.write((ec_inR + (ec_mono - ec_inR) * s_echo_pp) * (1 - s_echo_pp) + s_echo_fb * (ec_fbR * (1 - s_echo_pp) + ec_fbL * s_echo_pp));

// ---------------- CASSETTE
s_tape_on = h_tape_on + (tape_on - h_tape_on) * k_on;
h_tape_on = s_tape_on;
s_tape_wow = h_tape_wow + (tape_wow - h_tape_wow) * k_fast;
h_tape_wow = s_tape_wow;
s_tape_flutter = h_tape_flutter + (tape_flutter - h_tape_flutter) * k_fast;
h_tape_flutter = s_tape_flutter;
s_tape_sat = h_tape_sat + (tape_sat - h_tape_sat) * k_fast;
h_tape_sat = s_tape_sat;
s_tape_hiss = h_tape_hiss + (tape_hiss - h_tape_hiss) * k_fast;
h_tape_hiss = s_tape_hiss;
s_tape_age = h_tape_age + (tape_age - h_tape_age) * k_fast;
h_tape_age = s_tape_age;
s_tape_drop = h_tape_drop + (tape_drop - h_tape_drop) * k_fast;
h_tape_drop = s_tape_drop;
tp_a = tp_w1 + 0.53 / sr;
tp_a = tp_a - floor(tp_a);
tp_w1 = tp_a;
tp_b = tp_w2 + 0.31 / sr;
tp_b = tp_b - floor(tp_b);
tp_w2 = tp_b;
tp_c = tp_f1 + 7.3 / sr;
tp_c = tp_c - floor(tp_c);
tp_f1 = tp_c;
tp_rnd = tp_rn + (noise() - tp_rn) * (twopi * 1.2 / sr);
tp_rn = tp_rnd;
tp_wowv = sin(twopi * tp_a) * 0.6 + sin(twopi * tp_b) * 0.4 + tp_rnd * 8;
tp_flv = sin(twopi * tp_c) + noise() * 0.15;
tp_t = clamp((6 + tp_wowv * s_tape_wow * 3.5 + tp_flv * s_tape_flutter * 0.12) * 0.001 * sr, 2, 4090);
tp_trig = (noise() * 0.5 + 0.5) < (s_tape_drop * 1.5 / sr);
tp_depth = 0.35 + (noise() * 0.5 + 0.5) * 0.65;
tp_e = max(tp_env * (1 - 8 / sr), tp_trig * tp_depth);
tp_env = tp_e;
tp_gt = 1 - tp_e * min(s_tape_drop * 4, 1) * 0.85;
tp_g = tp_gz + (tp_gt - tp_gz) * (1 - exp(-1 / (0.004 * sr)));
tp_gz = tp_g;
tp_drive = pow(10, (s_tape_sat * 18) / 20);
tp_hf = 16000 - s_tape_age * 10500;
tp_dL.write(sL);
tpL_r = tp_dL.read(tp_t);
tpL_u = tpL_r * tp_drive;
tpL_s = (tanh(tpL_u + 0.08 * tpL_u * tpL_u / (1 + abs(tpL_u))) ) / (0.75 + 0.25 * tp_drive);
tpL_s = tpL_r + (tpL_s - tpL_r) * min(s_tape_sat * 3, 1);
tpLbm_A = pow(10, (1 + s_tape_age * 3) / 40);
tpLbm_g = tan(pi * clamp(85, 10, sr * 0.45) / sr);
tpLbm_k = 1 / ((1.1) * tpLbm_A);
tpLbm_a1 = 1 / (1 + tpLbm_g * (tpLbm_g + tpLbm_k));
tpLbm_a2 = tpLbm_g * tpLbm_a1;
tpLbm_a3 = tpLbm_g * tpLbm_a2;
tpLbm_v3 = tpL_s - tpLbm_s2;
tpLbm_v1 = tpLbm_a1 * tpLbm_s1 + tpLbm_a2 * tpLbm_v3;
tpLbm_v2 = tpLbm_s2 + tpLbm_a2 * tpLbm_s1 + tpLbm_a3 * tpLbm_v3;
tpLbm_n1 = 2 * tpLbm_v1 - tpLbm_s1;
tpLbm_n2 = 2 * tpLbm_v2 - tpLbm_s2;
tpLbm_s1 = tpLbm_n1;
tpLbm_s2 = tpLbm_n2;
tpLbm_o = tpL_s + tpLbm_k * (tpLbm_A * tpLbm_A - 1) * tpLbm_v1;
tpLlp_g = tan(pi * clamp(tp_hf, 10, sr * 0.45) / sr);
tpLlp_k = 1 / (0.75);
tpLlp_a1 = 1 / (1 + tpLlp_g * (tpLlp_g + tpLlp_k));
tpLlp_a2 = tpLlp_g * tpLlp_a1;
tpLlp_a3 = tpLlp_g * tpLlp_a2;
tpLlp_v3 = tpLbm_o - tpLlp_s2;
tpLlp_v1 = tpLlp_a1 * tpLlp_s1 + tpLlp_a2 * tpLlp_v3;
tpLlp_v2 = tpLlp_s2 + tpLlp_a2 * tpLlp_s1 + tpLlp_a3 * tpLlp_v3;
tpLlp_n1 = 2 * tpLlp_v1 - tpLlp_s1;
tpLlp_n2 = 2 * tpLlp_v2 - tpLlp_s2;
tpLlp_s1 = tpLlp_n1;
tpLlp_s2 = tpLlp_n2;
tpLnz_g = tan(pi * clamp(5500, 10, sr * 0.45) / sr);
tpLnz_k = 1 / (0.5);
tpLnz_a1 = 1 / (1 + tpLnz_g * (tpLnz_g + tpLnz_k));
tpLnz_a2 = tpLnz_g * tpLnz_a1;
tpLnz_a3 = tpLnz_g * tpLnz_a2;
tpLnz_v3 = noise() - tpLnz_s2;
tpLnz_v1 = tpLnz_a1 * tpLnz_s1 + tpLnz_a2 * tpLnz_v3;
tpLnz_v2 = tpLnz_s2 + tpLnz_a2 * tpLnz_s1 + tpLnz_a3 * tpLnz_v3;
tpLnz_n1 = 2 * tpLnz_v1 - tpLnz_s1;
tpLnz_n2 = 2 * tpLnz_v2 - tpLnz_s2;
tpLnz_s1 = tpLnz_n1;
tpLnz_s2 = tpLnz_n2;
tpL_o = tpLlp_v2 * tp_g + tpLnz_v1 * s_tape_hiss * s_tape_hiss * 0.02;
sL = sL + (tpL_o - sL) * s_tape_on;
tp_dR.write(sR);
tpR_r = tp_dR.read(tp_t);
tpR_u = tpR_r * tp_drive;
tpR_s = (tanh(tpR_u + 0.08 * tpR_u * tpR_u / (1 + abs(tpR_u))) ) / (0.75 + 0.25 * tp_drive);
tpR_s = tpR_r + (tpR_s - tpR_r) * min(s_tape_sat * 3, 1);
tpRbm_A = pow(10, (1 + s_tape_age * 3) / 40);
tpRbm_g = tan(pi * clamp(85, 10, sr * 0.45) / sr);
tpRbm_k = 1 / ((1.1) * tpRbm_A);
tpRbm_a1 = 1 / (1 + tpRbm_g * (tpRbm_g + tpRbm_k));
tpRbm_a2 = tpRbm_g * tpRbm_a1;
tpRbm_a3 = tpRbm_g * tpRbm_a2;
tpRbm_v3 = tpR_s - tpRbm_s2;
tpRbm_v1 = tpRbm_a1 * tpRbm_s1 + tpRbm_a2 * tpRbm_v3;
tpRbm_v2 = tpRbm_s2 + tpRbm_a2 * tpRbm_s1 + tpRbm_a3 * tpRbm_v3;
tpRbm_n1 = 2 * tpRbm_v1 - tpRbm_s1;
tpRbm_n2 = 2 * tpRbm_v2 - tpRbm_s2;
tpRbm_s1 = tpRbm_n1;
tpRbm_s2 = tpRbm_n2;
tpRbm_o = tpR_s + tpRbm_k * (tpRbm_A * tpRbm_A - 1) * tpRbm_v1;
tpRlp_g = tan(pi * clamp(tp_hf, 10, sr * 0.45) / sr);
tpRlp_k = 1 / (0.75);
tpRlp_a1 = 1 / (1 + tpRlp_g * (tpRlp_g + tpRlp_k));
tpRlp_a2 = tpRlp_g * tpRlp_a1;
tpRlp_a3 = tpRlp_g * tpRlp_a2;
tpRlp_v3 = tpRbm_o - tpRlp_s2;
tpRlp_v1 = tpRlp_a1 * tpRlp_s1 + tpRlp_a2 * tpRlp_v3;
tpRlp_v2 = tpRlp_s2 + tpRlp_a2 * tpRlp_s1 + tpRlp_a3 * tpRlp_v3;
tpRlp_n1 = 2 * tpRlp_v1 - tpRlp_s1;
tpRlp_n2 = 2 * tpRlp_v2 - tpRlp_s2;
tpRlp_s1 = tpRlp_n1;
tpRlp_s2 = tpRlp_n2;
tpRnz_g = tan(pi * clamp(5500, 10, sr * 0.45) / sr);
tpRnz_k = 1 / (0.5);
tpRnz_a1 = 1 / (1 + tpRnz_g * (tpRnz_g + tpRnz_k));
tpRnz_a2 = tpRnz_g * tpRnz_a1;
tpRnz_a3 = tpRnz_g * tpRnz_a2;
tpRnz_v3 = noise() - tpRnz_s2;
tpRnz_v1 = tpRnz_a1 * tpRnz_s1 + tpRnz_a2 * tpRnz_v3;
tpRnz_v2 = tpRnz_s2 + tpRnz_a2 * tpRnz_s1 + tpRnz_a3 * tpRnz_v3;
tpRnz_n1 = 2 * tpRnz_v1 - tpRnz_s1;
tpRnz_n2 = 2 * tpRnz_v2 - tpRnz_s2;
tpRnz_s1 = tpRnz_n1;
tpRnz_s2 = tpRnz_n2;
tpR_o = tpRlp_v2 * tp_g + tpRnz_v1 * s_tape_hiss * s_tape_hiss * 0.02;
sR = sR + (tpR_o - sR) * s_tape_on;

// ---------------- OUT
s_out_mix = h_out_mix + (out_mix - h_out_mix) * k_fast;
h_out_mix = s_out_mix;
s_out_width = h_out_width + (out_width - h_out_width) * k_fast;
h_out_width = s_out_width;
s_out_gain = h_out_gain + (out_gain - h_out_gain) * k_fast;
h_out_gain = s_out_gain;
o_m = (sL + sR) * 0.5;
o_s = (sL - sR) * 0.5 * s_out_width;
o_g = pow(10, s_out_gain / 20);
o_L = (in1 + ((o_m + o_s) - in1) * s_out_mix) * o_g;
o_R = (in2 + ((o_m - o_s) - in2) * s_out_mix) * o_g;
out1 = clamp(o_L, -4, 4);
out2 = clamp(o_R, -4, 4);
